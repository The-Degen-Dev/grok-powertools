{
  "manifest_version": 3,
  "name": "Grok Power Tools",
  "version": "0.2.0",
  "description": "Grok Imagine workflow tools for prompts, retries, media backup, and media recreation.",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting",
    "downloads",
    "alarms",
    "cookies",
    "offscreen",
    "debugger"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.grok.x.ai/*",
    "*://imagine-public.x.ai/*",
    "*://grok.com/*",
    "*://*.grok.com/*",
    "https://*.workers.dev/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grok Power Tools"
  },
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["*://grok.com/*", "*://*.grok.com/*", "*://*.x.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.grok.x.ai/*",
        "*://grok.com/*",
        "*://*.grok.com/*",
        "*://imagine-public.x.ai/*",
        "https://chatgpt.com/images*"
      ],
      "js": [
        "providerRegistry.js",
        "providerRunLedger.js",
        "chatgptImagesContent.js",
        "recreateWorkflowUtils.js",
        "recreateWorkflowContent.js",
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
