{
  "manifest_version": 3,
  "name": "Grok Media Downloader",
  "version": "0.2.0",
  "description": "Automate downloading media from Grok timeline.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "downloads",
    "alarms"
  ],
  "host_permissions": [
    "*://*.x.com/*",
    "*://*.grok.x.ai/*",
    "*://imagine-public.x.ai/*",
    "*://grok.com/*",
    "*://*.grok.com/*",
    "https://*.workers.dev/*",
    "https://*.r2.cloudflarestorage.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grok Downloader"
  },
  "web_accessible_resources": [
    {
      "resources": ["bridge.js"],
      "matches": ["*://grok.com/*", "*://*.grok.com/*", "*://*.x.com/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.x.com/*",
        "*://*.grok.x.ai/*",
        "*://grok.com/*",
        "*://*.grok.com/*",
        "*://imagine-public.x.ai/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "overlay.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
